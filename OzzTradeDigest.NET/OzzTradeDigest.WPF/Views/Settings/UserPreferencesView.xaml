<base:AbstractEditView x:Class="TD.WPF.Views.Settings.UserPreferencesView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:local="clr-namespace:TD.WPF.Views.Settings"
                       xmlns:i18n="clr-namespace:TD.i18n;assembly=OzzTradeDigest.i18n"
                       xmlns:ctr="clr-namespace:TD.WPF.Controls"
                       xmlns:base="clr-namespace:TD.WPF.Views"
                       mc:Ignorable="d"
                       Title="{x:Static i18n:CommonStrings.UserPreferences}"
                       Height="240" Width="640"
                       WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Language / UI Culture -->
        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold"
                   Style="{StaticResource RightAlignedTextBlockStyle}" Text="{x:Static i18n:CommonStrings.Language}"/>
        <ComboBox Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding AvailableCultures}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="CultureCode"
                  SelectedValue="{Binding UiCulture, Mode=TwoWay}"
                  Style="{StaticResource ValidationComboBoxStyle}"/>

        <!-- 2. Default Risk Amount -->
        <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Bold"
                   Style="{StaticResource RightAlignedTextBlockStyle}" Text="{x:Static i18n:CommonStrings.DefaultRisk}"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding DefaultRiskAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Style="{StaticResource ValidationTextBoxStyle}"
                 PreviewTextInput="DecimalTextBox_PreviewTextInput"/>

        <!-- 3. Image Save Folder -->
        <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="Bold"
                   Style="{StaticResource RightAlignedTextBlockStyle}" Text="{x:Static i18n:CommonStrings.ImageFolder}"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                 Text="{Binding ImagesFolder, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ValidationTextBoxStyle}"/>
        <Button Grid.Row="2" Grid.Column="3"
                Style="{StaticResource IconButtonStyle-28x24}"
                ToolTip="{x:Static i18n:ActionStrings.SelectFolder}" Click="BrowseFolder_Click" Margin="4,0,0,1">
            <Viewbox Width="18" Height="18">
                <Path Data="{StaticResource folder2-open}" Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </Viewbox>
        </Button>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static i18n:ActionStrings.OK}" Width="90" Margin="0,0,10,0" IsDefault="True" Click="OkButton_Click" />
            <Button Content="{x:Static i18n:ActionStrings.Cancel}" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</base:AbstractEditView>
